{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "name": "barbarossa",
  "version": 2,
  "buildCommand": "npm run generate",
  "outputDirectory": ".output/public",
  "installCommand": "npm install",
  "build": {
    "env": {
      "NUXT_PUBLIC_API_BASE": "https://barbarossa-api-a231.onrender.com/api"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://barbarossa-api-a231.onrender.com/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ],
  "env": {
    "API_BASE": "https://barbarossa-api-a231.onrender.com/api",
    "NUXT_PUBLIC_API_BASE": "https://barbarossa-api-a231.onrender.com/api",
    "SUPABASE_URL": "https://hrcepttoscyhbntaqema.supabase.co"
  }
}
